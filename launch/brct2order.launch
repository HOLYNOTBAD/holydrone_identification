<launch>
  <arg name="download_ulog" default="false"/>
  <arg name="output" default="$(find holydrone_identification)/data/$(anon flight)"/>
  <arg name="config" default="$(find holydrone_identification)/config/brct2order.yaml"/>
  <arg name="exit_mode" default="POSCTL"/>
  <include file="$(find holydrone_identification)/launch/identification_fsm.launch">
    <arg name="download_ulog" value="$(arg download_ulog)"/>
    <arg name="output" value="$(arg output)"/>
    <arg name="config" value="$(arg config)"/>
    <arg name="exit_mode" value="$(arg exit_mode)"/>
    <arg name="exciter" value="brct2order_excite"/>
  </include>
</launch>
