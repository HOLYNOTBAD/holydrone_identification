<launch>
  <arg name="config" default="$(find holydrone_identification)/config/gazebo_physics.yaml"/>
  <arg name="exit_mode" default="POSCTL"/>
  <include file="$(find holydrone_identification)/launch/identification_fsm.launch">
    <arg name="config" value="$(arg config)"/>
    <arg name="exciter" value="gazebo_physics_excite"/>
    <arg name="exit_mode" value="$(arg exit_mode)"/>
  </include>
</launch>
