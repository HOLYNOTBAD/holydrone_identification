<!-- 启动 holydrone_identification 的 gazebo_physics；参数按 arg 显式传递，节点参数位于各自私有空间。 -->
<launch>
  <arg name="motor_speed_output" default=""/>
  <node if="$(eval arg('motor_speed_output') != '')" pkg="holydrone_identification"
        type="record_motor_speed.py" name="record_motor_speed" output="screen" required="true">
    <param name="output" value="$(arg motor_speed_output)"/>
  </node>
  <!-- 激励或候选 YAML 路径；传给被包含 launch 或节点配置 -->
  <arg name="config" default="$(find holydrone_identification)/config/gazebo_physics/gazebo_physics.yaml"/>
  <!-- 包含 $(find holydrone_identification)/launch/excitation/identification_fsm.launch，下列 arg 传递本入口的配置 -->
  <include file="$(find holydrone_identification)/launch/excitation/identification_fsm.launch">
    <!-- 激励或候选 YAML 路径；传给被包含 launch 或节点配置 -->
    <arg name="config" value="$(arg config)"/>
    <!-- 激励节点可执行文件/名称；支持 brct1order_excite、gazebo_physics_excite -->
    <arg name="exciter" value="gazebo_physics_excite"/>
  </include>
</launch>
