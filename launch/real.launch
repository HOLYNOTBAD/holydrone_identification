<launch>
  <arg name="config" default="$(find holydrone_identification)/config/brct1order.yaml"/>
  <include file="$(find holydrone)/launch/mavros_real.launch"/>
  <include file="$(find holydrone_identification)/launch/identification_fsm.launch">
    <arg name="config" value="$(arg config)"/>
  </include>
</launch>
